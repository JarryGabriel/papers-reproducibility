# Optional local overrides. Copy to .env and edit; never commit .env.
# Load explicitly from the project root: set -a; . ./.env; set +a
# Relative paths below are resolved from the project root.
OPENSKY26_DATA_DIR=./data
OPENSKY26_PIPELINE_CONFIG=src/opensky26_plateau/pipeline/config.yaml
# For non-editable installations, set OPENSKY26_PROJECT_ROOT to the checkout.
# Keep OpenSky / CDS credentials in their provider-specific local configuration.
